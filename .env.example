NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://xy_tutor@127.0.0.1:55432/xy_tutor
TEST_DATABASE_URL=postgres://xy_tutor@127.0.0.1:55432/xy_tutor_test
SESSION_SECRET=replace-with-at-least-32-random-characters

# OpenAI-compatible gateway. Never commit the actual API key.
LLM_BASE_URL=https://api.nerosun.cn/v1
LLM_MODEL=
LLM_API_KEY=
LLM_SUPPORTS_IMAGES=false
LLM_CONTEXT_WINDOW=16000
LLM_MAX_OUTPUT=2048
# Optional external services: not configured => explicit unavailable state
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=nerosun-storage
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OCR_PROVIDER=aliyun
# Optional separate OCR RAM pair; when BOTH blank, reuse the OSS RAM pair.
OCR_ACCESS_KEY_ID=
OCR_ACCESS_KEY_SECRET=
OCR_BASE_URL=
OCR_API_KEY=

# Production Compose (use URL-encoded password in DATABASE_URL)
APP_DOMAIN=
POSTGRES_PASSWORD=
SERVER_IMAGE=xy-tutor-server:local
WEB_IMAGE=xy-tutor-web:local
OPS_IMAGE=xy-tutor-ops:local
# Backup destination: a separate private bucket/prefix; never public-read.
BACKUP_OSS_REGION=
BACKUP_OSS_BUCKET=
BACKUP_OSS_PREFIX=xy-tutor/database
BACKUP_OSS_ACCESS_KEY_ID=
BACKUP_OSS_ACCESS_KEY_SECRET=
# Optional fixed HTTPS webhook; alerts contain only a generic failure code.
BACKUP_ALERT_URL=

# Phase flags. All default to false; adaptive practice requires self check.
TUTOR_SELF_CHECK_ENABLED=false
LEARNING_TIMING_ENABLED=false
ADAPTIVE_PRACTICE_ENABLED=false
LEARNING_EVALUATION_ENABLED=false
